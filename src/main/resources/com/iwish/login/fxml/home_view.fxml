<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768" prefWidth="1024"
    xmlns="http://javafx.com/javafx/17.0.1"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iwish.login.controllers.HomeController">

    <!-- Left Sidebar (Blue) -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="100" spacing="10" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="5" right="5" top="20" />
            </padding>

            <!-- Logo -->
            <VBox alignment="CENTER" styleClass="logo-container">
                <ImageView fitHeight="85.0" fitWidth="77.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/home_logo.png" />
                    </image>
                </ImageView>
            </VBox>

            <Region prefHeight="20" />

            <!-- Navigation -->
            <Button fx:id="homeNavButton" contentDisplay="TOP" maxWidth="Infinity" onAction="#handleHomeNav" styleClass="sidebar-button" text="Home">
                <graphic>
                    <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="🏠" />
                </graphic>
            </Button>

            <Button fx:id="wishlistNavButton" contentDisplay="TOP" maxWidth="Infinity" onAction="#handleWishlistNav" styleClass="sidebar-button" text="My Wishlist">
                <graphic>
                    <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="❤" />
                </graphic>
            </Button>

            <Button fx:id="friendsNavButton" contentDisplay="TOP" maxWidth="Infinity" onAction="#handleFriendsNav" styleClass="sidebar-button" text="Friends">
                <graphic>
                    <StackPane>
                        <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="👥" />
                        <Label fx:id="friendsBadgeSidebar" style="-fx-background-color: #e74c3c; -fx-background-radius: 5; -fx-min-width: 10; -fx-min-height: 10; -fx-max-width: 10; -fx-max-height: 10; -fx-translate-x: 10; -fx-translate-y: -8;" visible="false" />
                    </StackPane>
                </graphic>
            </Button>

            <Button fx:id="notificationsNavButton" contentDisplay="TOP" maxWidth="Infinity" onAction="#handleNotificationsNav" styleClass="sidebar-button" text="Notifications">
                <graphic>
                    <StackPane>
                        <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="🔔" />
                        <Label fx:id="notificationsBadgeSidebar" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 2 5 2 5; -fx-translate-x: 12; -fx-translate-y: -8;" text="" visible="false" />
                    </StackPane>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutButton" contentDisplay="TOP" maxWidth="Infinity" onAction="#handleLogout" text="Logout">
                <graphic>
                    <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="🚪" />
                </graphic>
                <styleClass>
                    <String fx:value="sidebar-button" />
                    <String fx:value="logout-button" />
                </styleClass>
            </Button>
        </VBox>
    </left>

    <!-- Center Content Area -->
    <center>
        <BorderPane styleClass="content-area">
            <!-- Global Top Header -->
            <top>
                <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 15 30 15 30; -fx-background-color: #F4F8FB;">
                    <!-- Spacer to push content right -->
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Welcome Message -->
                    <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;" text="Welcome, User" />

                    <!-- Notifications Badge REMOVED -->

                    <!-- Account Icon -->

                    <!-- Account Icon -->
                    <StackPane style="-fx-cursor: hand; -fx-background-color: #3498db; -fx-background-radius: 20; -fx-pref-width: 40; -fx-pref-height: 40;">
                        <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="👤" />
                    </StackPane>
                </HBox>
            </top>

            <!-- View Content -->
            <center>
                <StackPane fx:id="contentArea" />
            </center>
        </BorderPane>
    </center>

</BorderPane>
