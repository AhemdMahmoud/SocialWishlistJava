<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-view" stylesheets="@../styles/friends.css"
    xmlns="http://javafx.com/javafx/17.0.1"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iwish.login.controllers.FriendsController">

    <top>
        <VBox fx:id="friendsHeader" spacing="20" styleClass="friends-header">
            <padding>
                <Insets bottom="20" left="30" right="30" top="20" />
            </padding>

            <!-- Page Title -->
            <Label styleClass="page-title" text="Friends" />

            <!-- Tab Navigation -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <ToggleButton fx:id="myFriendsTab" onAction="#showMyFriends" selected="true" styleClass="tab-button" text="My Friends" />
                <StackPane>
                    <ToggleButton fx:id="friendRequestsTab" onAction="#showFriendRequests" styleClass="tab-button" text="Add Friends" />
                    <Label fx:id="requestsBadge" visible="false" mouseTransparent="true" style="-fx-background-color: #e74c3c; -fx-min-width: 10; -fx-min-height: 10; -fx-max-width: 10; -fx-max-height: 10; -fx-background-radius: 5;" StackPane.alignment="TOP_RIGHT">
                        <StackPane.margin>
                            <Insets top="-2" right="-2"/>
                        </StackPane.margin>
                    </Label>
                </StackPane>
                <TextField fx:id="searchField" onAction="#handleGlobalSearch" onKeyReleased="#handleSearchInput" promptText="Search your friends..." styleClass="search-input" HBox.hgrow="ALWAYS" />
                <Button fx:id="searchButton" onAction="#handleGlobalSearch" styleClass="search-button" text="Search" />
            </HBox>

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" maxWidth="600" spacing="15" />
        </VBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets bottom="30" left="30" right="30" top="10" />
            </padding>

            <!-- My Friends View -->
            <VBox fx:id="myFriendsView" managed="true" spacing="15" visible="true">
                <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="friendsList" spacing="15" styleClass="friends-list-container" />
                </ScrollPane>
            </VBox>

            <!-- Friend Requests View -->
            <VBox fx:id="friendRequestsView" managed="false" spacing="15" visible="false">
                <ScrollPane fitToHeight="true" fitToWidth="true" pannable="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="requestsList" minHeight="400" spacing="15" styleClass="friends-list-container" />
                </ScrollPane>
            </VBox>

            <!-- Search Results View (for adding friends) -->
            <VBox fx:id="searchResultsView" managed="false" spacing="15" visible="false">
                <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="searchResultsList" spacing="15" styleClass="friends-list-container" />
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
