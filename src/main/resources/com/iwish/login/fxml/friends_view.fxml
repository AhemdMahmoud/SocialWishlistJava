<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iwish.login.controllers.FriendsController" styleClass="content-view" stylesheets="@../styles/friends.css">

    <top>
        <VBox spacing="20" styleClass="friends-header">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <!-- Page Title -->
            <Label text="Friends" styleClass="page-title"/>

            <!-- Tab Navigation -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <ToggleButton fx:id="myFriendsTab" text="My Friends" selected="true" onAction="#showMyFriends" styleClass="tab-button"/>
                <ToggleButton fx:id="friendRequestsTab" text="Friend Requests" onAction="#showFriendRequests" styleClass="tab-button"/>
            </HBox>

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15" maxWidth="600">
                <TextField fx:id="searchField" promptText="Search your friends..." HBox.hgrow="ALWAYS" styleClass="search-input" onKeyReleased="#handleSearchInput" onAction="#handleGlobalSearch"/>
                <Button fx:id="searchButton" text="Search" styleClass="search-button" onAction="#handleGlobalSearch"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets top="10" right="30" bottom="30" left="30"/>
            </padding>

            <!-- My Friends View -->
            <VBox fx:id="myFriendsView" visible="true" managed="true" spacing="15">
                <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="friendsList" spacing="15" styleClass="friends-list-container"/>
                </ScrollPane>
            </VBox>

            <!-- Friend Requests View -->
            <VBox fx:id="friendRequestsView" visible="false" managed="false" spacing="15">
                <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="requestsList" spacing="15" styleClass="friends-list-container"/>
                </ScrollPane>
            </VBox>

            <!-- Search Results View (for adding friends) -->
            <VBox fx:id="searchResultsView" visible="false" managed="false" spacing="15">
                <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="searchResultsList" spacing="15" styleClass="friends-list-container"/>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
