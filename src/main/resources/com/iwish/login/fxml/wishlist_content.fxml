<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="30.0" styleClass="main-content"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iwish.login.controllers.WishlistController" stylesheets="@../styles/wishlist.css">

    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Label styleClass="header-label" text="My Wishlist" />
                <Region HBox.hgrow="ALWAYS" />
                <!-- Add items button could go here -->
            </children>
            <padding>
                <Insets bottom="20.0" top="20.0" left="0.0" right="0.0" />
            </padding>
        </HBox>

        <!-- Wishlist Items List -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="itemsContainer" spacing="30.0">
                    <padding>
                        <Insets bottom="30.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
