<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iwish.client.NotificationsController" stylesheets="@../login/styles/friends.css">

    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20" />
            </padding>
            <children>
                <Button text="← Back" onAction="#handleBack" styleClass="back-button" />
                <Region HBox.hgrow="NEVER" style="-fx-pref-width: 15;" />
                <Label text="Notifications" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="refresh-button" />
            </children>
        </HBox>
    </top>

    <center>
        <ListView fx:id="notificationsList" style="-fx-background-color: white; -fx-padding: 20;" />
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20" />
            </padding>
            <children>
                <Button text="Mark Selected as Read" onAction="#handleMarkSelectedAsRead" styleClass="action-button" />
                <Region HBox.hgrow="NEVER" style="-fx-pref-width: 15;" />
                <Label fx:id="statusLabel" style="-fx-text-fill: #666; -fx-padding: 5;" />
            </children>
        </HBox>
    </bottom>

</BorderPane>