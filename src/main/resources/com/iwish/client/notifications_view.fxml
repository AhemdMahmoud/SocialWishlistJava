<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="content-view" stylesheets="@../login/styles/friends.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iwish.client.NotificationsController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="friends-header">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>
                <Button onAction="#handleBack" styleClass="action-button-blue" text="← Back" />
                <Region style="-fx-pref-width: 15;" HBox.hgrow="NEVER" />
                <Label styleClass="page-title" text="Notifications" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" onAction="#handleRefresh" styleClass="action-button-green" text="Refresh" />
            </children>
        </HBox>
    </top>

    <center>
        <ListView fx:id="notificationsList" style="-fx-background-color: white; -fx-padding: 20;" />
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="friends-header">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>
                <Button onAction="#handleMarkSelectedAsRead" styleClass="action-button-red" text="Mark Selected as Read" />
                <Region style="-fx-pref-width: 15;" HBox.hgrow="NEVER" />
                <Label fx:id="statusLabel" styleClass="status-label" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
